generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organisation {
  id                String             @id @default(cuid())
  name              String
  apiKey            String             @unique @default(cuid())
  email             String?
  passwordHash      String?
  emailVerified     Boolean            @default(false)
  discordWebhook    String?
  usdcBalance       Float              @default(0)
  totalFeesCharged  Float              @default(0)
  payoutWallet      String?
  createdAt         DateTime           @default(now())
  protocols         Protocol[]
  executions        SpellRecord[]
  payments          ExecutionPayment[]
}

model Protocol {
  id                   String        @id @default(cuid())
  orgId                String
  org                  Organisation  @relation(fields: [orgId], references: [id])
  config               Json          // ProtocolConfig stored here
  status               String        @default("MONITORING")
  keeperHubTemplateId  String?
  keeperHubTemplateUrl String?
  keeperHubWalletId    String?
  keeperHubWalletAddress String?
  createdAt            DateTime      @default(now())
}

model SpellRecord {
  id                    String          @id @default(cuid())
  orgId                 String?
  org                   Organisation?   @relation(fields: [orgId], references: [id])
  protocolId            String          @default("sky")
  spellAddress          String          @unique
  calledAt              DateTime        // when hat() changed to this spell
  earliestExecution     DateTime        // calledAt + GSM delay
  latestExecution       DateTime        // calledAt + 30 days
  officeHoursActive     Boolean
  nextExecutionWindow   DateTime        // first valid office-hours slot
  calldata              String          // raw calldata hex
  actions               Json            // parsed action list
  status                SpellStatus     @default(QUEUED)
  simulationScore       SimulationScore?
  conflictStatus        ConflictStatus?
  conflictDetail        String?
  detectionSource       String?         // "watcher" | "keeperhub-scheduler" | "both"
  executedAt            DateTime?
  txHash                String?
  gasUsed               BigInt?
  keeperHubExecutionId  String?
  keeperHubWorkflowId   String?
  keeperHubAuditLog     Json?
  keeperHubStatus       String?
  x402PaymentTxHash     String?
  x402AmountUsdc        Float?
  x402SettledAt         DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model ExecutionPayment {
  id                String        @id @default(cuid())
  orgId             String
  org               Organisation  @relation(fields: [orgId], references: [id])
  spellAddress      String
  feeUsdc           Float
  x402PaymentTxHash String?
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  settledAt         DateTime?
}

enum PaymentStatus {
  PENDING
  SETTLED
  FAILED
}

enum SpellStatus {
  QUEUED
  SIMULATING
  CONFLICT
  READY
  EXECUTING
  EXECUTED
  FAILED
  EXPIRED
  HELD
}

enum SimulationScore {
  GREEN
  YELLOW
  RED
}

enum ConflictStatus {
  CLEAR
  CONFLICT
}
